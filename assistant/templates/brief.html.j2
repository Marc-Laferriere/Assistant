<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Morning brief — {{ generated }}</title>
<style>
  :root {
    --bg:#f7f7f5; --card:#fff; --ink:#1c1c1a; --muted:#6b6b66; --line:#e4e4df;
    --high:#b3261e; --normal:#1f6feb; --low:#8a8a84; --chip:#eceae4; --accent:#0a7c3a;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg:#1a1a18; --card:#242422; --ink:#ececE8; --muted:#9a9a92; --line:#343430;
      --high:#f2564b; --normal:#5aa0ff; --low:#7f7f78; --chip:#302f2b; --accent:#4bd07f;
    }
  }
  * { box-sizing:border-box; }
  body { margin:0; background:var(--bg); color:var(--ink);
    font:15px/1.5 -apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif; }
  .wrap { max-width:820px; margin:0 auto; padding:28px 20px 60px; }
  h1 { font-size:20px; margin:0 0 2px; }
  .sub { color:var(--muted); font-size:13px; margin-bottom:22px; }
  .tallies { display:flex; gap:14px; flex-wrap:wrap; margin-bottom:26px; font-size:13px; }
  .tally b { font-size:17px; display:block; }
  h2 { font-size:13px; text-transform:uppercase; letter-spacing:.06em;
    color:var(--muted); margin:28px 0 10px; border-bottom:1px solid var(--line); padding-bottom:6px; }
  .item { background:var(--card); border:1px solid var(--line); border-radius:9px;
    padding:12px 14px; margin-bottom:9px; }
  .item .top { display:flex; align-items:baseline; gap:8px; }
  .dot { width:8px; height:8px; border-radius:50%; flex:none; margin-top:6px; }
  .dot.high { background:var(--high); } .dot.normal { background:var(--normal); }
  .dot.low { background:var(--low); }
  .subject { font-weight:600; }
  .meta { color:var(--muted); font-size:12.5px; margin-top:3px; }
  .reason { font-size:13.5px; margin-top:5px; }
  .chip { background:var(--chip); border-radius:5px; padding:1px 7px; font-size:11.5px;
    color:var(--muted); white-space:nowrap; }
  .task { border-left:3px solid var(--accent); }
  .task .do { color:var(--accent); font-weight:600; font-size:13.5px; margin-top:5px; }
  details { margin-top:6px; } summary { cursor:pointer; color:var(--muted); font-size:13px; }
  .buried li { color:var(--muted); font-size:12.5px; margin:3px 0; list-style:none; }
  .empty { color:var(--muted); font-style:italic; font-size:13px; }
  a.subject-link { color:inherit; text-decoration:none; }
  a.subject-link:hover { text-decoration:underline; }
  .num { display:inline-flex; align-items:center; justify-content:center; width:20px; height:20px;
    border-radius:50%; background:var(--accent); color:#fff; font-size:11px; font-weight:700;
    flex:none; margin-top:1px; }
  .someday .dot { background:var(--low); }
  .rfi { border-left:3px solid var(--normal); }
  .rfi.answered { border-left-color:var(--high); }
  .rfi .resp { font-size:13.5px; margin-top:5px; white-space:pre-wrap; }
</style>
</head>
<body>
<div class="wrap">
  <h1>Morning brief</h1>
  <div class="sub">{{ generated }} · last {{ window_hours }} h</div>

  <div class="tallies">
    <div class="tally"><b>{{ plan|length }}</b> planned today</div>
    <div class="tally"><b>{{ counts.high }}</b> important</div>
    <div class="tally"><b>{{ counts.normal }}</b> can wait</div>
    <div class="tally"><b>{{ counts.low }}</b> buried</div>
    <div class="tally"><b>{{ counts.tasks }}</b> possible tasks</div>
  </div>

  {% if rfi.answered %}
  <h2>Your RFIs: replies</h2>
  {% for r in rfi.answered %}
  <div class="item rfi answered">
    <div class="subject">{{ r.label }} {{ r.title }}</div>
    <div class="meta">
      {% if r.project %}<span class="chip">{{ r.project }}</span> · {% endif %}
      Procore #{{ r.pnum }} · <span class="chip">{{ 'answered and closed' if r.status == 'closed' else 'answered' }}</span>
      · {{ (r.last_event_at or '')[:10] }}
    </div>
    {% if r.response %}<div class="resp">{{ r.response[:700] }}{% if r.response|length > 700 %}…{% endif %}</div>{% endif %}
  </div>
  {% endfor %}
  {% endif %}

  {% if subm.released %}
  <h2>Submittals released</h2>
  {% for r in subm.released %}
  <div class="item rfi answered">
    <div class="subject">{{ (r.number ~ ' ' ~ r.title)|trim }}</div>
    <div class="meta">
      {% if r.project %}<span class="chip">{{ r.project }}</span> · {% endif %}
      <span class="chip">{{ 'your equipment' if r.category == 'ours' else 'watching: ' ~ r.matched }}</span>
      {% if r.response %} · <span class="chip">{{ r.response }}</span>{% endif %}
      · {{ (r.last_event_at or '')[:10] }}
    </div>
    {% if r.summary %}<div class="reason">{{ r.summary }}</div>{% endif %}
  </div>
  {% endfor %}
  {% endif %}

  <h2>Today's plan</h2>
  {% if plan %}
  {% for t in plan %}
  <div class="item task">
    <div class="top">
      <span class="num">{{ loop.index }}</span>
      <div style="flex:1">
        <div>
          {% if t.url %}<a class="subject-link" href="{{ t.url }}"><span class="subject">{{ t.title }}</span></a>
          {% else %}<span class="subject">{{ t.title }}</span>{% endif %}
        </div>
        <div class="meta">
          {% if t.project %}<span class="chip">{{ t.project }}</span>{% endif %}
          {% if t.due %} · due {{ t.due }}{% endif %}
          {% if t.priority %} · {{ t.priority }}{% endif %}
        </div>
        {% if t.reason %}<div class="reason">{{ t.reason }}</div>{% endif %}
      </div>
    </div>
  </div>
  {% endfor %}
  {% if plan_note %}<div class="empty">{{ plan_note }}</div>{% endif %}
  {% if plan_left_out > 0 %}
  <div class="empty">{{ plan_left_out }} more Active task{{ 's' if plan_left_out != 1 }} not scheduled today.</div>
  {% endif %}
  {% elif plan_active_count == 0 %}
  <div class="empty">Nothing in Notion marked Active right now.</div>
  {% else %}
  <div class="empty">Planning is unavailable this run — see logs.</div>
  {% endif %}

  {% macro row(m, task=False) %}
  <div class="item {{ 'task' if task }}">
    <div class="top">
      <span class="dot {{ m.importance }}"></span>
      <div style="flex:1">
        <div><span class="subject">{{ m.subject or '(no subject)' }}</span></div>
        <div class="meta">
          {{ m.from_name or m.from_addr }}{% if m.from_name %} &lt;{{ m.from_addr }}&gt;{% endif %}
          · {{ (m.date_utc or '')[:16]|replace('T',' ') }}
          · <span class="chip">{{ m.folder }}</span>
          {% if m.project %} · <span class="chip">{{ m.project }}</span>{% endif %}
          {% if m.category %} · <span class="chip">{{ m.category }}</span>{% endif %}
          {% if m.has_attach %} · &#128206;{% endif %}
          {% if m.is_answered %} · <span class="chip">&#8617; replied</span>{% endif %}
        </div>
        {% if task and m.suggested_action %}<div class="do">&#9654; {{ m.suggested_action }}</div>{% endif %}
        {% if m.reason %}<div class="reason">{{ m.reason }}</div>{% endif %}
      </div>
    </div>
  </div>
  {% endmacro %}

  {% if rfi.waiting %}
  <h2>RFIs waiting on a reply ({{ rfi.waiting|length }})</h2>
  {% for w in rfi.waiting %}
  <div class="item rfi">
    <div class="subject">{{ w.label }} {{ w.title }}</div>
    <div class="meta">
      {% if w.project %}<span class="chip">{{ w.project }}</span> · {% endif %}
      {% if w.pnum %}submitted as Procore #{{ w.pnum }}{% else %}in internal review / not yet in Procore{% endif %}
      {% if w.days is not none %} · {{ w.days }} day{{ 's' if w.days != 1 }} ago{% endif %}
    </div>
  </div>
  {% endfor %}
  {% endif %}

  <h2>Important</h2>
  {% for m in high %}{{ row(m) }}{% else %}<div class="empty">Nothing flagged important.</div>{% endfor %}

  {% if tasks %}
  <h2>Possible tasks</h2>
  {% for m in tasks %}{{ row(m, task=True) }}{% endfor %}
  {% endif %}

  {% if rfi.others %}
  <h2>Other RFIs</h2>
  {% for o in rfi.others %}
  <div class="item rfi">
    <div class="subject">#{{ o.number }} {{ o.title }}</div>
    <div class="meta">
      {% if o.project %}<span class="chip">{{ o.project }}</span> · {% endif %}
      <span class="chip">{{ o.status }}</span>
    </div>
    <div class="reason">{{ o.summary }}</div>
  </div>
  {% endfor %}
  {% endif %}

  {% if subm.others %}
  <h2>Other submittals</h2>
  {% for o in subm.others %}
  <div class="item rfi">
    <div class="subject">{{ (o.number ~ ' ' ~ o.title)|trim }}</div>
    <div class="meta">{% if o.project %}<span class="chip">{{ o.project }}</span>{% endif %}
      {% if o.response %} · <span class="chip">{{ o.response }}</span>{% endif %}</div>
    {% if o.summary %}<div class="reason">{{ o.summary }}</div>{% endif %}
  </div>
  {% endfor %}
  {% endif %}

  {% if meets %}
  <h2>Trade meetings</h2>
  {% for g in meets %}
  <div class="item rfi{{ ' answered' if g.company_items }}">
    <div class="subject">{{ g.project }} · {{ g.date }}</div>
    {% for area, line in g.company_items %}
    <div class="reason"><b>Your company:</b> {% if area %}({{ area }}) {% endif %}{{ line }}</div>
    {% endfor %}
    {% for a in g.areas %}{% if a.pours %}
    <div class="reason"><b>Pours and the trade days before them:</b>
      <ul style="margin:3px 0 0">{% for p in a.pours %}<li><b>{{ p.line }}</b>{% if p.trade_days %} &mdash; trade days: {{ p.trade_days }}{% else %} &mdash; no trade days listed{% endif %}</li>{% endfor %}</ul></div>
    {% endif %}{% endfor %}
    {% for a in g.areas %}{% if a.schedule %}
    <div class="reason"><b>Coming up{% if a.area %} ({{ a.area }}){% endif %}:</b>
      <ul style="margin:3px 0 0">{% for x in a.schedule %}<li>{{ x }}</li>{% endfor %}</ul></div>
    {% endif %}{% endfor %}
    <details><summary>summary</summary>
      {% for a in g.areas %}
      {% if a.area %}<div class="meta"><b>{{ a.area }}</b></div>{% endif %}
      <ul>{% for p in a.points %}<li>{{ p }}</li>{% endfor %}</ul>
      {% endfor %}
    </details>
  </div>
  {% endfor %}
  {% endif %}

  <h2>Can wait</h2>
  {% for m in normal %}{{ row(m) }}{% else %}<div class="empty">Nothing here.</div>{% endfor %}

  {% if someday %}
  <h2>From the someday pile ({{ someday_count }} total)</h2>
  {% for t in someday %}
  <div class="item someday">
    <div class="top">
      <span class="dot low"></span>
      <div style="flex:1">
        <div>
          {% if t.url %}<a class="subject-link" href="{{ t.url }}"><span class="subject">{{ t.title }}</span></a>
          {% else %}<span class="subject">{{ t.title }}</span>{% endif %}
        </div>
        {% if t.project %}<div class="meta"><span class="chip">{{ t.project }}</span></div>{% endif %}
      </div>
    </div>
  </div>
  {% endfor %}
  {% endif %}

  <h2>Buried ({{ counts.low }})</h2>
  {% if low %}
  <details><summary>show</summary>
    <ul class="buried">
      {% for m in low[:low_limit] %}
      <li>{{ (m.date_utc or '')[:10] }} · {{ m.from_addr }} · {{ m.subject or '(no subject)' }}</li>
      {% endfor %}
      {% if low|length > low_limit %}<li>… and {{ low|length - low_limit }} more</li>{% endif %}
    </ul>
  </details>
  {% else %}<div class="empty">Nothing buried.</div>{% endif %}
</div>
</body>
</html>
